# Copy to .env and fill in. Never commit the .env file.
# Lines left commented out use their default value.

# --- Connection to MediaOCD ---
# Required. Create it in MediaOCD under Settings > Application tokens.
MEDIAOCD_TOKEN=
# Default: http://localhost:7481. In the same Compose project: http://mediaocd:7481
#MEDIAOCD_URL=
# Seconds to wait for an answer (1 to 300). Default: 25
#MEDIAOCD_TIMEOUT=

# --- Client authentication ---
# Token that MCP clients must send as "Authorization: Bearer <token>". At least 24
# characters, for example the output of: openssl rand -hex 32
# Required to listen on anything other than the loopback address.
MCP_AUTH_TOKEN=
# Set to true to listen on a non-loopback address WITHOUT authentication. Anyone who can
# reach the port can then read and change your library. Trusted networks only.
#MCP_ALLOW_UNAUTHENTICATED=

# --- Server ---
# streamable-http (default) or stdio
#MCP_TRANSPORT=
# Default: 127.0.0.1 (0.0.0.0 in the Docker image)
#MCP_HOST=
# Default: 8016
#MCP_PORT=
# Extra values accepted in the Host and Origin headers, separated by commas. The loopback
# addresses are always accepted. Needed to connect by any other name or address, for
# example: MCP_ALLOWED_HOSTS=mcp.example.org,192.0.2.10:8016
#MCP_ALLOWED_HOSTS=
#MCP_ALLOWED_ORIGINS=
# DEBUG, INFO, WARNING, ERROR or CRITICAL. Default: INFO
#MCP_LOG_LEVEL=
